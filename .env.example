# VITE_WEATHER_PROVIDER_MODE: 'mock' | 'real'
# mock → 하드코딩된 테스트 데이터 사용. API 키 불필요.
# real → 실제 OpenWeather API 사용. OPENWEATHER_API_KEY 필요.
VITE_WEATHER_PROVIDER_MODE=mock

# real 모드에서만 필요. https://openweathermap.org/api 에서 발급.
# 서버 전용 값이다 — VITE_ 접두사를 붙이지 않는다. 붙이면 클라이언트 번들에 그대로 노출된다.
# OPENWEATHER_API_KEY=your_api_key_here
